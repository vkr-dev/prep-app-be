# --- LLM ---
# "1" = Anthropic, "2" = Google - picks which app/llm/*_client.py handles
# every pipeline step's LLM calls (see app/llm/client.py). Only the active
# provider's key below actually needs to be set.
LLM_PROVIDER=1

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# console.cloud.google.com / aistudio.google.com - free tier, good for
# dev/test iteration without spending Anthropic credit.
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-3.6-flash

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-long-random-string

# Owner is seeded from these on startup - status=owner, permanent access.
OWNER_EMAIL=you@example.com
# Generate with: python scripts/hash_password.py
OWNER_PASSWORD_HASH=

# --- DB (Neon Postgres - permanent user + cache store) ---
# Use Neon's POOLED connection string (hostname has "-pooler" in it), not the
# direct one - better suited to an app server holding its own connection
# pool. Prefix must stay postgresql+psycopg (tells SQLAlchemy which driver).
DATABASE_URL=postgresql+psycopg://user:password@host-pooler.neon.tech/dbname?sslmode=require&channel_binding=require

# --- CORS ---
# Comma-separated list of allowed origins. Lock to the deployed static-site origin in prod.
CORS_ALLOW_ORIGINS=http://localhost:4200
