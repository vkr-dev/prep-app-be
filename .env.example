# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-5

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=change-me-to-a-long-random-string

# Owner is seeded from these on startup - status=owner, permanent access.
OWNER_EMAIL=you@example.com
# Generate with: python scripts/hash_password.py
OWNER_PASSWORD_HASH=

# --- DB (Neon Postgres - permanent user store) ---
DATABASE_URL=postgresql+psycopg://user:password@host.neon.tech/dbname?sslmode=require

# --- CORS ---
# Comma-separated list of allowed origins. Lock to the deployed static-site origin in prod.
CORS_ALLOW_ORIGINS=http://localhost:4200
